<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  A7 logs 支柱（测试期日志格式）+ DoD #3（审计/应用日志物理分离）的证明载体。

  ★★ 为什么是 logback-test.xml 且第一个 appender 叫 CONSOLE ★★
   1) 「日志带不带 traceId」只有在【渲染后】才能证明。若 pattern 里不引用
      %X{traceId}, MDC 里就算有值也不会出现在日志行上 —— 于是会出现
      "单元测试断言 MDC.get(traceId)!=null 是绿的，运维翻开日志却找不到 traceId"
      这种两个结论同时成立的假绿。故本文件显式引用全部 MDC 键，
      ObservabilityMdcFilterTest 再去读真实渲染输出。

   2) 「file/test.log 里绝不像/绝很像的串」用来防【另一类】假绿：
      见 AuditLogSeparationTest —— 用两个文件互不包含对方的标记串，
      证明的不是"配置里写了两行"，而是"条目真的分了两路落地"。

   3) $${...} 是给 Spring 的【转义】：Spring Boot 会先解析 ${...} 形式的占位符，
      写成 ${traceId} 会被 Spring 当成属性引用解析掉，整份日志配置加载失败。
      $$ 表示"这个交给 Logback"。
  ============================================================================
-->
<configuration>

    <property name="DY_APP_LOG_FILE" value="${DY_APP_LOG_FILE:-target/test-logs/dy-app.log}"/>
    <property name="DY_AUDIT_LOG_FILE" value="${DY_AUDIT_LOG_FILE:-target/test-logs/dy-audit.log}"/>

    <property name="DY_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-}] [tenant=%X{tenantId:-}] [method=%X{dy.method:-}] [path=%X{dy.path:-}] [entry=%X{dy.entry:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${DY_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         应用日志: 只被 DY.APP logger 与 root 引用。
         ============================================================ -->
    <appender name="APP_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${DY_APP_LOG_FILE}</file>
        <encoder>
            <pattern>${DY_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         审计日志: 只被 DY.AUDIT logger 引用, 【不】挂 root, 【不】挂 CONSOLE。
         审计条目上控制台会让它混进应用日志被同一套采集流程收走, 分离就白做了。
         ============================================================ -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${DY_AUDIT_LOG_FILE}</file>
        <encoder>
            <pattern>${DY_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      additivity=false 是分离的【关键开关】。
      默认 true 会让 DY.AUDIT 的事件同时上抛给 root -> 顺着 root 落进 APP_FILE。
      结果: 文件分了, 内容没分（审计条目在两个文件里各有一份）。
    -->
    <logger name="DY.AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <logger name="DY.APP" level="INFO" additivity="false">
        <appender-ref ref="APP_FILE"/>
    </logger>

    <!--
      观察性测试的专用出口: 本类自己的日志只写这里, 便于逐行读取。
      additivity=false 避免它同时写 CONSOLE 造成噪声（也让"本类日志不影响其它断言"成立）。
    -->
    <logger name="com.diaoyuanyun.dy.web.observability.ObservabilityMdcFilterTest"
            level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>

</configuration>