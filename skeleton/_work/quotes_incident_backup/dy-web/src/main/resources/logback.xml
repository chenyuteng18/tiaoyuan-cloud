<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  dy-web 模块自带日志配置 —— A7 DoD #3: 审计日志与应用日志【物理分离】。

  为什么这份配置放在 dy-web/src/main/resources 而不是 dy-app
    dy-web 是唯一需要"自证分离成立"的模块：分离规则的定义、logger 名约定
    (DyLoggers) 与守护测试都在这里。把配置放在同一个模块，规则与它的证词
    才能一起被搬走 —— 否则换个应用装配这份规则就丢了。

  覆盖关系（刻意做成不冲突）
    Spring Boot 默认监听 classpath 上的 logback.xml。若应用侧以后自己放了
    logback-spring.xml，那份文件优先级更高并会整体接管 —— 那时本文件不再生效，
    但断言测试（AuditLogSeparationTest）会立刻红，因为模板里少了 appender。
    这是刻意的：分离规则允许被替换，但不允许被【静默】替换。

  分离的三个维度（缺一不可）
    1) logger 名  : DY.APP vs DY.AUDIT（无前缀继承关系, 见 DyLoggers 的静态自检）
    2) appender   : APP_FILE vs AUDIT_FILE, 各自只被一个 logger 引用
    3) 输出文件   : dy-app.log vs dy-audit.log（不同文件 = 可不同保留期/权限）

  ★★ 已登记的跨模块副作用（如实说明, 不是"顺手改"）★★
    本文件在 dy-web/src/main/resources/ 下, 因而会随 dy-web jar 进入 dy-app 的
    classpath 并【被 Spring Boot 采纳】。后果: dy-app 运行时会在工作目录下
    生成 logs/dy-app.log 与 logs/dy-audit.log（此前只有控制台输出）。
    三点说明:
      1) 这是 DoD #3 要求"落地"而非仅"声明"的必然结果 —— 只写在文档里的分离规则
         等于没有分离规则。要落地就必须有一份真实生效的 logback 配置。
      2) 落到哪个目录由 LOG_DIR / APP_LOG_FILE / AUDIT_LOG_FILE 三个属性控制,
         运维可在部署层覆盖（本文件用 ${} 占位符 + 默认值）。
      3) 不放在 dy-app 侧的原因: dy-web 是唯一需要"自证分离成立"的模块
         （规则定义、logger 名约定 DyLoggers、守护测试都在这里）。把配置放到同一个
         模块, 规则与它的证词才能一起被搬走。

  ⚠️ 已知缺口（不在本任务的改动范围内, 如实登记）: 目前【没有】生产代码向
     DY.AUDIT 这个 logger 写事件 —— dy-audit 的审计条目走 JdbcAuditLogService 落库
     （append-only + 哈希链）。也就是说本文件把"审计与应用日志的分离【机制】"
     落地并验证了, 但"审计事件经 logger 输出"这条通道尚无生产者。
     写在注释里而不是留白, 是为了避免下一个人把"配置存在"误读成"审计已走这条路"。
  ============================================================================
-->
<configuration>

    <!--
      与 Spring Boot 默认属性对齐, 使本文件在没有 Spring 环境时(纯单元测试)也能解析。
      LOG_DIR 走系统属性/变量, 是为了让测试能把输出重定向到临时目录 ——
      否则跑一次测试就会在模块目录里留下 logs/, 并被误提交。
    -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <!-- 两个文件由 JVM 系统属性覆盖, 使"分离"这件事本身可被测试指向临时目录 -->
    <property name="APP_LOG_FILE" value="${APP_LOG_FILE:-${LOG_DIR}/dy-app.log}"/>
    <property name="AUDIT_LOG_FILE" value="${AUDIT_LOG_FILE:-${LOG_DIR}/dy-audit.log}"/>

    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-}] [tenant=%X{tenantId:-}] [method=%X{dy.method:-}] [path=%X{dy.path:-}] [entry=%X{dy.entry:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 应用日志：普通业务/技术日志。 -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${APP_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${APP_LOG_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      审计日志：谁在什么时候对哪条数据做了什么。
      保留期比应用日志长(合规证据), 且【不】加 CONSOLE ——
      审计条目上控制台会让它混进应用日志被一起采集, 分离就白做了。
    -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUDIT_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${AUDIT_LOG_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>365</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      logger 绑定。
      additivity=false 是分离的【关键开关】：默认 additivity=true 会让子 logger 把事件
      同时上抛给 root, 于是审计条目既进 AUDIT_FILE 又顺着 root 进 APP_FILE ——
      文件是分了, 内容没分。加了 false 才能保证"审计条目只出现在审计文件里"。
    -->
    <logger name="DY.AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <logger name="DY.APP" level="INFO" additivity="false">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>

</configuration>