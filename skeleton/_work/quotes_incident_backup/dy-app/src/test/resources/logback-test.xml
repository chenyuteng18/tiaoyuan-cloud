<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  dy-app 测试期日志配置 —— 修「dy-app 测试污染源码树」的真实缺陷。

  ★★ 缺陷是什么（已确定性复现）★★
    dy-app 此前【没有】src/test/resources/，于是测试 classpath 上唯一的 logback
    配置是 dy-web/src/main/resources/logback.xml。那份配置的默认值是

        <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
        <file>${LOG_DIR}/dy-app.log</file>

    而全仓库【没有任何地方设置 LOG_DIR】（没有 surefire 配置、没有测试
    System.setProperty）—— 于是默认值 `logs` 生效。surefire 的工作目录是模块
    basedir，所以每跑一次 dy-app 测试就在源码树里生成 dy-app/logs/{dy-app.log,
    dy-audit.log}。本仓库既无 .gitignore 也非 git 仓库，这是实打实的源码树污染，
    不是"反正会被忽略"。dy-web 那份配置的注释里【承诺】"LOG_DIR 走系统属性/变量,
    是为了让测试能把输出重定向到临时目录"—— 但那个缓解措施当时并不存在。

  ★★ 修复方式：照 dy-web 的既有先例，把输出指向 target/ ★★
    dy-web/src/test/resources/logback-test.xml 用
    ${DY_APP_LOG_FILE:-target/test-logs/dy-app.log} 把输出挪到 target/ 下。
    本文件照抄这个模式。Logback 的配置查找顺序里 logback-test.xml 优先于
    logback.xml，且 test-classes 在 classpath 上先于 classes，故本文件会
    正确地遮蔽 dy-web 那份。

  ★★ 刻意【不】做什么（最小化，避免制造第二个真相源）★★
    本文件【不】声明 DY.APP / DY.AUDIT logger，也【不】复刻 additivity=false
    那套审计/应用日志分离规则。理由：分离规则的真相源是
    dy-web/src/main/resources/logback.xml，并由 dy-web 的 AuditLogSeparationTest
    在 dy-web 模块内对它的结构事实（additivity、独立 appender、独立文件）做断言。
    若在这里再写一份，就变成了两份会各自漂移的分离规则 —— 而"两个真相源"
    恰恰比"没有分离规则"更危险：改了一处、另一处不报错。

    dy-app 测试只需要一件事：日志落到 target/ 下、配置可解析、测试输出不丢。
    故本文件只保留 root -> {CONSOLE, APP_FILE}。dy-app 测试里没有任何断言
    依赖 MDC 字段的渲染格式（那是 dy-web 的 ObservabilityMdcFilterTest 的职责），
    故 pattern 保持最简，不引用 %X{...}。
  ============================================================================
-->
<configuration>

    <!-- 输出落在模块的 target/ 下：build 产物、可随时删、不会被误提交 -->
    <property name="DY_APP_LOG_FILE" value="${DY_APP_LOG_FILE:-target/test-logs/dy-app.log}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${DY_APP_LOG_FILE}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 保留 CONSOLE：诊断测试失败时最方便的通道，去掉会让排障变难 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>

</configuration>