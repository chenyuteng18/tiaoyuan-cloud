{
  "name": "dy-therapist-app",
  "version": "0.1.0",
  "private": true,
  "description": "端 B · 调理师 / 经络师 APP（契约驱动骨架，Vite + React + TS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:endpoints": "node ../tools/gen-endpoints.mjs",
    "check:contract": "node ../tools/gen-endpoints.mjs --check",
    "check:build": "node ../tools/build-check.mjs --end=therapist-app",
    "check:x3": "node ../tools/x3-check.mjs",
    "check:x3-reverse": "node ../tools/x3-reverse-check.mjs",
    "check:build-reverse": "node ../tools/build-reverse-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
