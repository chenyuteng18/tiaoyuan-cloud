/* 端 C · 客户小程序 —— 全局样式（设计令牌）
 * ============================================================================
 * 令牌取自 app.json 的导航栏配色（深绿 + 暖米），保证"导航栏与页面"是同一套色，
 * 不出现"导航是深绿、页面是默认蓝"的分裂。
 *
 * 🛑 为什么本文件刻意没有任何评分 / 达成度 / 分级类样式
 * ---------------------------------------------------------------------------
 * 客户端可见性由服务端判定（X-1），且客户不得看到任何由手环数据推导出的结果
 * （§2.6.2 W-1）。样式层同样不提供这类视觉元件 —— 不是"藏起来"，而是**这一端
 * 不存在**这种呈现形态。手环页只有"正向计数"与"中性描述"两件视觉元素。
 */

page {
  background-color: #FAF8F4;
  color: #23302B;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

/* ---- 卡片 ---- */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8E4DC;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D5A4A;
  margin-bottom: 16rpx;
  display: block;
}

/* ---- 键值行 ---- */
.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F1EEE8;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #6E7A75;
  flex: 0 0 auto;
  margin-right: 24rpx;
}

.value {
  color: #23302B;
  text-align: right;
  flex: 1 1 auto;
  word-break: break-all;
}

/* ---- 主按钮 ---- */
.btn {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 0;
  background: #2D5A4A;
  color: #FFFFFF;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.btn[disabled] {
  background: #C4CCC8;
  color: #FFFFFF;
}

.btn-plain {
  background: #FFFFFF;
  color: #2D5A4A;
  border: 1rpx solid #2D5A4A;
}

/* ---- 带日期的输入 ---- */
.input {
  border: 1rpx solid #E8E4DC;
  border-radius: 12rpx;
  padding: 18rpx;
  background: #FFFFFF;
  margin-bottom: 16rpx;
}

/* ---- 点选组（每日填报：全点选，无开放输入）---- */
.opt-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.opt {
  padding: 16rpx 28rpx;
  border: 1rpx solid #E8E4DC;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #23302B;
}

.opt.on {
  background: #E7F0EB;
  border-color: #2D5A4A;
  color: #2D5A4A;
  font-weight: 600;
}

.opt-label {
  display: block;
  color: #6E7A75;
  font-size: 26rpx;
  margin: 16rpx 0 12rpx;
}

/* ---- 手环：正向计数 + 中性描述（W-2）---- */
.count {
  font-size: 56rpx;
  font-weight: 600;
  color: #2D5A4A;
  line-height: 1.2;
}

.count-unit {
  font-size: 26rpx;
  color: #6E7A75;
  margin-left: 8rpx;
}

.neutral {
  color: #6E7A75;
  font-size: 26rpx;
}

/* ---- 同屏告知（W-3 必须存在的两个节点）---- */
.notice {
  background: #F4F1EA;
  border-left: 6rpx solid #2D5A4A;
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.notice-text {
  display: block;
  color: #4A544F;
  font-size: 25rpx;
  line-height: 1.7;
}

/* ---- 状态与提示 ---- */
.hint {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  background: #FDF6E8;
  border: 1rpx solid #EFE0BE;
  border-radius: 12rpx;
  color: #7A6428;
  font-size: 25rpx;
  line-height: 1.7;
}

.error {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  background: #FCEFEF;
  border: 1rpx solid #F0D2D2;
  border-radius: 12rpx;
  color: #8C3B3B;
  font-size: 25rpx;
  line-height: 1.7;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9AA5A0;
  font-size: 26rpx;
}

/* ---- 列表项 ---- */
.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1EEE8;
}

.list-item:last-child {
  border-bottom: none;
}

.list-main {
  display: block;
  color: #23302B;
  font-size: 29rpx;
  font-weight: 500;
}

.list-sub {
  display: block;
  color: #8A8F8C;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ---- 页面头部 ---- */
.page-head {
  padding: 8rpx 0 24rpx;
}

.page-head-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #23302B;
}

.page-head-sub {
  display: block;
  font-size: 25rpx;
  color: #8A8F8C;
  margin-top: 8rpx;
}