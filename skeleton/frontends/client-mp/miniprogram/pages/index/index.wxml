<view class="page">
  <view class="page-head">
    <text class="page-head-title">{{hasCustomer && customerName ? customerName : '我的'}}</text>
    <text class="page-head-sub">调元云 · 客户小程序</text>
  </view>

  <view class="error" wx:if="{{errText}}">{{errText}}</view>

  <!-- ② 本周填报进度：正向计数，无达成度视觉 -->
  <view class="card" wx:if="{{hasCustomer}}">
    <text class="card-title">本周填报</text>
    <view class="row" wx:if="{{weeklyCount !== ''}}">
      <text class="label">本周已填</text>
      <text class="value">{{weeklyCount}} / 7 天</text>
    </view>
    <view class="row" wx:if="{{weeklyCompareText}}">
      <text class="label">上周</text>
      <text class="value">{{weeklyCompareText}}</text>
    </view>
    <view class="empty" wx:if="{{weeklyCount === ''}}">本周暂无填报记录</view>
    <button class="btn btn-plain" bindtap="goDailyReport">去填报</button>
  </view>

  <!-- ③ 手环采集情况：正向计数 + 中性描述；未接入时不显示 0 -->
  <view class="card" wx:if="{{hasCustomer && showBandBlock}}">
    <text class="card-title">手环数据</text>
    <view class="row">
      <text class="label">数据来源</text>
      <text class="value">{{bandSourceText}}</text>
    </view>
    <block wx:if="{{!bandNotConnected}}">
      <view class="row" wx:if="{{bandCollectedText}}">
        <text class="label">采集情况</text>
        <text class="value">{{bandCollectedText}}</text>
      </view>
      <view class="row" wx:if="{{bandSyncLine}}">
        <text class="label">同步时间</text>
        <text class="value">{{bandSyncLine}}</text>
      </view>
    </block>
    <view class="notice">
      <text class="notice-text">{{bandReferenceNotice}}</text>
    </view>
    <button class="btn btn-plain" bindtap="goBand">查看手环数据</button>
  </view>

  <view class="card" wx:if="{{hasCustomer}}">
    <text class="card-title">我的</text>
    <button class="btn btn-plain" bindtap="goProfile">档案与评估</button>
  </view>

  <view class="hint" wx:if="{{loading}}">正在加载…</view>
</view>