<view class="page">
  <view class="page-head">
    <text class="page-head-title">登录</text>
    <text class="page-head-sub">账号由门店建档时生成</text>
  </view>

  <view class="card">
    <text class="opt-label">手机号</text>
    <input class="input" type="number" placeholder="请输入手机号" value="{{account}}" bindinput="onAccount" />

    <text class="opt-label">登录口令</text>
    <input class="input" password placeholder="请输入登录口令" value="{{credential}}" bindinput="onCredential" />

    <button class="btn" disabled="{{submitting}}" bindtap="onSubmit">登录</button>

    <view class="error" wx:if="{{errText}}">{{errText}}</view>
  </view>
</view>