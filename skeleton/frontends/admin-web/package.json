{
  "name": "dy-admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "端 A · 管理员 Web（契约驱动骨架，Vite + React + TS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:endpoints": "python ../tools/gen-endpoints.py",
    "check:contract": "python ../tools/gen-endpoints.py --check",
    "check:build": "node ../tools/build-check.mjs --end=admin-web",
    "check:a": "node ../tools/a-check.mjs",
    "check:a-reverse": "node ../tools/a-reverse-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
