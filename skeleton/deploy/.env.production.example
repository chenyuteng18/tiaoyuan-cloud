# ============================================================================
# 调元云 · 生产环境变量清单（模板）
#
# 用法:  cp .env.production.example .env && chmod 600 .env && 逐项填写
# 🛑 .env 含全部生产机密，不进 git；泄露 = 全量重置密钥 + 轮换凭证
# ============================================================================

# ---- 数据库（PostgreSQL 17 容器自建）----
# 库名 / 账号与应用 RLS 体系无冲突即可；密码必须强随机
DB_NAME=diaoyuanyun_prod
DB_USERNAME=diaoyuanyun
# 生成示例: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_random

# ---- Redis（幂等后端 / 吊销黑名单；prod 下 memory 会被启动自检拒绝）----
REDIS_PASSWORD=CHANGE_ME_strong_random

# ---- JWT（HS256；>=32 字节，JwtVerifier/JwtIssuer 构造期校验）----
# 生成示例: openssl rand -base64 48
# 🛑 与历史 token 的吊销关系：换密钥 = 全员重新登录（可接受的操作开关）
DY_JWT_SECRET=CHANGE_ME_at_least_32_bytes_random

# ---- 加密主密钥（手环遥测字段级加密等；建议上云 KMS 注入）----
DY_MASTER_KEY=CHANGE_ME_via_kms
# 首次部署 true（自动生成 KEK 并落库）；扩容/恢复已有数据时必须 false
DY_CRYPTO_AUTO_PROVISION_KEK=false
